# Copy to backend/.env. Fill credentials locally and keep .env out of Git.
# SECRET_KEY must contain at least 32 characters.
SECRET_KEY=
DATABASE_URL=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=YOUR_CHAT_MODEL_ID
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v1
VECTOR_DIMENSION=1536

# Optional reranking. Set RERANK_ENABLED=true after configuring a valid key.
RERANK_ENABLED=false
QWEN_API_KEY=
QWEN_MODEL=gte-rerank-v2
RERANK_TOP_K=10
RERANK_FINAL_K=10

# Dify chat application using /chat-messages and inputs.type=1..6.
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_USER_ID=hr-agent-user

# Separate HR resource service; do not point this back at the application itself.
HR_SERVICE_HOST=127.0.0.1
HR_SERVICE_PORT=8000
HR_SERVICE_APIKEY=

KB_QUERY_ENHANCE_ENABLED=true
KB_QUERY_EXPANSION_MAX_TERMS=6
RAG_CONTENT_WEIGHT=0.7
RAG_TEXT_WEIGHT=0.3
RAG_MIN_SIMILARITY_SCORE=0.2
CONTEXT_LIMIT=10
UPLOAD_DIR=uploads
REMOTE_SERVICE_LOG_ENABLED=false
